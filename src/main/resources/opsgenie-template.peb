{
    {% if alias is defined %}
        "alias": "{{alias}}",
    {% endif %}
    {% if responders is defined %}
        "responders": [
    {% for responder in responders %}
            ,{
                "id": {{ responder.key | toJson }},
                "type": {{ responder.value | toJson }}
            }
    {% endfor %}
        ],
    {% endif %}
    {% if visibleTo is defined %}
        "visibleTo": [
    {% for responder in visibleTo %}
        ,{
            "id": {{ responder.key | toJson }},
            "type": {{ responder.value | toJson }}
        }
    {% endfor %}
        ],
    {% endif %}
    {% if tags is defined %}
        "tags": [
        {% for tag in tags %}
            {{ tag | toJson }}
        {% endfor %}
        ],
    {% endif %}
    {% if priority is defined %}
        "priority": "{{priority}}",
    {% endif %}
    {% if message is defined %}
        "message": "{{message}}",
    {% endif %}
    {% if (details is defined) or (customFields is defined and customFields is not empty) %}
        "details": {
            "Namespace": "{{execution.namespace}}",
            "Flow ID": "{{execution.flowId}}",
            "Execution ID": "{{execution.id}}",
            "Execution Status": "{{execution.state.current}}",
            "Final task ID": "{{lastTask.taskId}}"
            {% if customFields is defined and customFields is not empty %}
                {% for entry in customFields %}
                    , {{ entry.key | toJson }}: {{ (entry.value ~ "") | toJson }}
                {% endfor %}
            {% endif %}
        },
    {% endif %}
    "description": "*<{{link}}|[{{execution.namespace}}] {{execution.flowId}} ➛ {{execution.state.current}} - Final task ID {{lastTask.taskId}}>*\n> {% if firstFailed == false %}Succeeded{% else %}Failed on task `{{firstFailed.taskId}}`{% endif %} after {{duration}}{% if customMessage is defined and customMessage is not empty %}{% set jsonMessage = customMessage | toJson %}\n\n{{ jsonMessage | slice(1, (jsonMessage | length) - 1) }}{% endif %}"
}
